# ==========================================================
# Environment Variables - انسخ الملف ده لـ .env واملأ القيم الحقيقية
# ==========================================================

PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/moneymeters
PGSSL=false

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS - دومين الـ Frontend المسموح له
CORS_ORIGIN=http://localhost:5173

# Geofence / Idle Alerts
IDLE_ALERT_MINUTES=15
DEFAULT_GEOFENCE_RADIUS_M=1000
